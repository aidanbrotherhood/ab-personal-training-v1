---
export const prerender = true;

import NewsletterForm from "../components/forms/NewsletterForm.astro";
import PostCard from "../components/cards/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomepageWriting } from "../lib/writing";

const homepagePosts = await getHomepageWriting(3);
---

<BaseLayout
  title="Aidan Brotherhood"
  description="A calm, minimal home for coaching, health, and writing."
>
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow">Coaching · Health · Writing</p>
      <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-[-0.04em] text-ink sm:text-6xl">
        A serious foundation for a body of work.
      </h1>
      <p class="lede mt-6">
        This is the first version of the Aidan Brotherhood website: a place for writing, coaching information,
        and future ways to get in touch.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          class="inline-flex items-center justify-center rounded-full bg-ink px-5 py-3 text-sm font-semibold text-paper-soft no-underline transition hover:bg-accent"
          href="/writing"
        >
          Read writing
        </a>
        <a
          class="inline-flex items-center justify-center rounded-full border border-line px-5 py-3 text-sm font-semibold no-underline transition hover:border-accent"
          href="/coaching"
        >
          Explore coaching
        </a>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-readable">
          <p class="eyebrow">Writing</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">Recent notes</h2>
          <p class="mt-3 text-ink-muted">
            Featured writing appears here first. If fewer than three posts are featured, the latest published posts fill
            the space.
          </p>
        </div>
        <a class="text-sm font-semibold text-ink-muted no-underline hover:text-ink hover:underline" href="/writing">
          View all writing →
        </a>
      </div>

      {
        homepagePosts.length > 0 ? (
          <div class="mt-8 grid gap-6 lg:grid-cols-3">
            {homepagePosts.map((post) => (
              <PostCard post={post} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <div class="mt-8 rounded-3xl border border-line bg-paper-soft p-8">
            <h3 class="text-2xl font-semibold tracking-tight">Writing will appear here soon.</h3>
            <p class="mt-3 max-w-readable text-ink-muted">
              Published MDX entries in <code>src/content/writing</code> will populate this section automatically.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="content-section">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-6 lg:px-8">
      <NewsletterForm
        id="home-newsletter-form"
        heading="Get writing updates"
        description="Occasional notes on coaching, training, health, and ownership."
      />
    </div>
  </section>
</BaseLayout>
