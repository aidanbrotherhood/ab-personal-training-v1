---
export const prerender = true;

import NewsletterForm from "../components/forms/NewsletterForm.astro";
import PostCard from "../components/cards/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomepageWriting } from "../lib/writing";

const homepagePosts = await getHomepageWriting(3);
---

<BaseLayout
  title="Aidan Brotherhood"
  description="Practical coaching for strength, conditioning, gym confidence, body composition, and long-term physical capability."
>
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl">
      <p class="eyebrow">Personal training · Strength · Capability</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-semibold text-ink sm:text-5xl">
        Practical coaching for a stronger, more capable body.
      </h1>
      <p class="lede mt-6">
        Aidan helps adults build strength, conditioning, gym confidence, body composition habits, and long-term
        physical capability without hype, punishment, or quick-fix promises.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="button-primary" href="/contact">
          Get Started
        </a>
        <a class="button-secondary" href="/coaching">
          Explore coaching
        </a>
        <a class="button-secondary" href="/posts">
          Read posts
        </a>
      </div>
    </div>

    <div class="mt-12 grid border-y border-line text-sm md:grid-cols-4 md:divide-x md:divide-line">
      <div class="py-5 md:px-5 md:first:pl-0">
        <p class="font-bold text-ink">Strength</p>
        <p class="mt-2 leading-6 text-ink-muted">Simple progression and better exercise confidence.</p>
      </div>
      <div class="border-t border-line py-5 md:border-t-0 md:px-5">
        <p class="font-bold text-ink">Conditioning</p>
        <p class="mt-2 leading-6 text-ink-muted">Useful fitness that supports daily life and training.</p>
      </div>
      <div class="border-t border-line py-5 md:border-t-0 md:px-5">
        <p class="font-bold text-ink">Body composition</p>
        <p class="mt-2 leading-6 text-ink-muted">Nutrition habits and tracking without drama.</p>
      </div>
      <div class="border-t border-line py-5 md:border-t-0 md:px-5 md:last:pr-0">
        <p class="font-bold text-ink">Gym confidence</p>
        <p class="mt-2 leading-6 text-ink-muted">Clear practice, calmer decisions, fewer unknowns.</p>
      </div>
    </div>
  </section>

  <section class="content-section bg-paper-soft">
    <div class="mx-auto grid w-full max-w-6xl gap-5 px-5 sm:px-6 md:grid-cols-3 lg:px-8">
      <article class="surface-card p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <p class="eyebrow">Get Started</p>
          <span class="text-sm font-bold text-accent-strong">01</span>
        </div>
        <h2 class="mt-3 text-2xl font-semibold">Start with context.</h2>
        <p class="mt-3 leading-7 text-ink-muted">
          Share your goals, background, confidence level, and what kind of support might fit.
        </p>
        <a class="text-link mt-5 inline-block" href="/contact">
          Start enquiry →
        </a>
      </article>

      <article class="surface-card p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <p class="eyebrow">Coaching</p>
          <span class="text-sm font-bold text-accent-strong">02</span>
        </div>
        <h2 class="mt-3 text-2xl font-semibold">Choose the right support.</h2>
        <p class="mt-3 leading-7 text-ink-muted">
          Personal training, strength and conditioning, body composition, nutrition, and remote or hybrid coaching.
        </p>
        <a class="text-link mt-5 inline-block" href="/coaching">
          View services →
        </a>
      </article>

      <article class="surface-card p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <p class="eyebrow">Posts</p>
          <span class="text-sm font-bold text-accent-strong">03</span>
        </div>
        <h2 class="mt-3 text-2xl font-semibold">Think clearly about training.</h2>
        <p class="mt-3 leading-7 text-ink-muted">
          Short notes on capability, consistency, health ownership, and the ordinary work of getting stronger.
        </p>
        <a class="text-link mt-5 inline-block" href="/posts">
          Go to posts →
        </a>
      </article>
    </div>
  </section>

  <section class="content-section">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-readable">
          <p class="eyebrow">Posts</p>
          <h2 class="mt-3 text-3xl font-semibold">Recent notes</h2>
          <p class="mt-3 leading-7 text-ink-muted">
            Clear, compact writing on training, coaching, and rebuilding physical capability.
          </p>
        </div>
        <a class="text-link" href="/posts">
          View all posts →
        </a>
      </div>

      {
        homepagePosts.length > 0 ? (
          <div class="mt-8 grid gap-6 lg:grid-cols-3">
            {homepagePosts.map((post) => (
              <PostCard post={post} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <div class="surface-card mt-8 p-8">
            <h3 class="text-2xl font-semibold">Posts will appear here soon.</h3>
            <p class="mt-3 max-w-readable text-ink-muted">Published posts will populate this section automatically.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="content-section">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-6 lg:px-8">
      <NewsletterForm
        id="home-newsletter-form"
        heading="Get posts by email"
        description="A short, useful email when there is something worth sending."
      />
    </div>
  </section>
</BaseLayout>
