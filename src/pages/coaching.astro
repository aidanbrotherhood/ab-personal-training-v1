---
export const prerender = true;

import CoachingEnquiryForm from "../components/forms/CoachingEnquiryForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Coaching"
  description="Coaching information for Aidan Brotherhood."
>
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-readable">
      <p class="eyebrow">Coaching</p>
      <h1 class="mt-5 text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">Coaching information will live here.</h1>
      <p class="lede mt-6">
        This page is ready for a clear coaching offer, boundaries, and enquiry path. The enquiry form validates safely,
        but CRM and email integrations are intentionally deferred.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-5 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div class="max-w-readable">
        <p class="eyebrow">Start a conversation</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">Tell me what you are looking for.</h2>
        <p class="mt-4 leading-7 text-ink-muted">
          Use the form for a coaching question or a first enquiry. Keep it practical and high-level for now; if coaching
          is appropriate, any screening detail can happen separately.
        </p>
      </div>
      <CoachingEnquiryForm />
    </div>
  </section>
</BaseLayout>
