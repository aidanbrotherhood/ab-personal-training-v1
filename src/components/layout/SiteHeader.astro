---
const navItems = [
  { href: "/posts", label: "Posts" },
  { href: "/coaching", label: "Coaching" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header sticky top-0 z-40 border-b border-line/80 bg-paper-soft/90 backdrop-blur">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-5 gap-y-2 px-5 py-2 sm:flex-nowrap sm:px-6 sm:py-3 lg:px-8">
    <a
      href="/"
      class="heading-font inline-flex items-center gap-3 text-sm font-bold text-ink no-underline sm:text-base"
      aria-label="Aidan Brotherhood home"
    >
      <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      <span>Aidan Brotherhood</span>
    </a>
    <nav class="w-full sm:ml-auto sm:w-auto" aria-label="Primary navigation">
      <ul class="flex flex-nowrap items-center gap-x-1.5 overflow-x-auto pb-1 text-[0.8125rem] text-ink-muted sm:justify-end sm:overflow-visible sm:pb-0 sm:text-sm">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "shrink-0 rounded-brand px-2 py-1.5 font-semibold no-underline transition-colors hover:bg-accent-soft hover:text-accent-strong sm:px-2.5 sm:py-2",
                  isActive(item.href) && "bg-accent-soft text-accent-strong",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contact"
            aria-current={isActive("/contact") ? "page" : undefined}
            class:list={[
              "button-primary button-small ml-1 shrink-0",
              isActive("/contact") && "border-accent-strong bg-accent-strong",
            ]}
          >
            Get Started
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
