---
import type { Service } from "../../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const href = `/coaching/${service.slug}`;
---

<article class="surface-card group flex h-full flex-col p-5 transition-colors hover:border-accent/50 sm:p-6">
  <div class="flex flex-1 flex-col">
    <div class="h-1 w-10 rounded-full bg-accent" aria-hidden="true"></div>
    <p class="mt-5 text-sm font-bold text-accent-strong">{service.price}</p>
    <h3 class="mt-3 text-xl font-semibold">
      <a class="no-underline decoration-accent/35 underline-offset-4 group-hover:underline" href={href}>{service.title}</a>
    </h3>
    <p class="mt-3 flex-1 leading-7 text-ink-muted">{service.description}</p>
  </div>
  <a class="text-link mt-5" href={href}>
    View details →
  </a>
</article>
