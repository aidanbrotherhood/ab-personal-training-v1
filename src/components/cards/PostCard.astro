---
import type { WritingPost } from "../../lib/writing";
import { formatPostDate, getPostSummary, getWritingPath } from "../../lib/writing";
import TagPill from "./TagPill.astro";

interface Props {
  post: WritingPost;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h2" } = Astro.props;
const HeadingTag = headingLevel;
const summary = getPostSummary(post);
const path = getWritingPath(post);
---

<article class="surface-card group h-full p-5 transition-colors hover:border-accent/50 sm:p-6">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-ink-muted">
    <time datetime={post.data.publishedDate.toISOString()}>{formatPostDate(post.data.publishedDate)}</time>
    {
      post.data.featured && (
        <span class="rounded-brand border border-accent/15 bg-accent-soft px-2.5 py-1 text-xs font-bold text-accent-strong">
          Featured
        </span>
      )
    }
  </div>

  <HeadingTag class="mt-4 text-2xl font-semibold text-ink">
    <a class="no-underline decoration-accent/35 underline-offset-4 group-hover:underline" href={path}>
      {post.data.title}
    </a>
  </HeadingTag>

  <p class="mt-3 max-w-readable text-base leading-7 text-ink-muted">{summary}</p>

  {
    post.data.tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tags for ${post.data.title}`}>
        {post.data.tags.map((tag) => (
          <li>
            <TagPill tag={tag} />
          </li>
        ))}
      </ul>
    )
  }
</article>
