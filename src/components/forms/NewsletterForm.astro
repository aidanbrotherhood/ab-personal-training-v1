---
interface Props {
  id?: string;
  heading?: string;
  description?: string;
  class?: string;
}

const {
  id = "newsletter-form",
  heading = "A useful note, when it earns its place",
  description = "Short, practical ideas on training, standards, and building a body you can rely on. No filler.",
  class: className = "",
} = Astro.props;

const inputClass = "form-input";
const errorClass = "form-error";
---

<form
  id={id}
  class:list={["newsletter-form surface-card p-5 sm:p-7", className]}
  action="/api/subscribe"
  method="post"
  data-enhanced-form
  data-success-message="Thanks — you’re on the list."
  data-generic-error-message="Something went wrong. Please try again."
  novalidate
>
  <div>
    <p class="eyebrow">Newsletter</p>
    <h2 class="mt-3 text-2xl font-semibold">{heading}</h2>
    <p class="mt-3 max-w-readable leading-7 text-ink-muted">{description}</p>
  </div>

  <div class="newsletter-fields mt-6">
    <div class="newsletter-name-grid">
      <div>
        <label class="form-label" for={`${id}-firstName`}>First name</label>
        <input
          class={inputClass}
          id={`${id}-firstName`}
          name="firstName"
          type="text"
          autocomplete="given-name"
          maxlength="80"
          placeholder="First name"
          required
          aria-describedby={`${id}-firstName-error`}
        />
        <p id={`${id}-firstName-error`} class={errorClass} data-error-for="firstName"></p>
      </div>

      <div>
        <label class="form-label" for={`${id}-lastName`}>Last name</label>
        <input
          class={inputClass}
          id={`${id}-lastName`}
          name="lastName"
          type="text"
          autocomplete="family-name"
          maxlength="80"
          placeholder="Last name"
          required
          aria-describedby={`${id}-lastName-error`}
        />
        <p id={`${id}-lastName-error`} class={errorClass} data-error-for="lastName"></p>
      </div>
    </div>

    <div>
      <label class="form-label" for={`${id}-email`}>Email address</label>
      <input
        class={inputClass}
        id={`${id}-email`}
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        placeholder="you@example.com"
        required
        aria-describedby={`${id}-email-error`}
      />
      <p id={`${id}-email-error`} class={errorClass} data-error-for="email"></p>
    </div>
  </div>

  <input type="hidden" name="sourcePage" />
  <input type="hidden" name="utmSource" />
  <input type="hidden" name="utmMedium" />
  <input type="hidden" name="utmCampaign" />
  <input type="hidden" name="utmTerm" />
  <input type="hidden" name="utmContent" />

  <div class="hidden" aria-hidden="true">
    <label for={`${id}-website`}>Website</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center">
    <button
      class="button-primary disabled:cursor-not-allowed disabled:opacity-60"
      type="submit"
      data-idle-label="Send me the useful notes"
      data-loading-label="Sending…"
    >
      Send me the useful notes
    </button>
    <p class="text-sm text-ink-muted" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<script>
  import { enhanceForms } from "../../lib/form-client";

  enhanceForms();
  document.addEventListener("astro:page-load", enhanceForms);
</script>
