---
import { mainInterestOptions, preferredContactMethodOptions } from "../../lib/validation";

interface Props {
  id?: string;
}

const { id = "coaching-enquiry-form" } = Astro.props;

const inputClass =
  "mt-2 w-full rounded-2xl border border-line bg-paper-soft px-4 py-3 text-base text-ink shadow-none transition placeholder:text-ink-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20";
const errorClass = "mt-2 min-h-5 text-sm text-red-700";
---

<form
  id={id}
  class="rounded-3xl border border-line bg-paper-soft p-6 sm:p-8"
  action="/api/enquiry"
  method="post"
  data-enhanced-form
  data-success-message="Thanks — I’ve got this. I’ll get back to you soon."
  data-generic-error-message="Something went wrong. Please try again."
  novalidate
>
  <div>
    <p class="eyebrow">Enquiry</p>
    <h2 class="mt-3 text-2xl font-semibold tracking-tight">Send a coaching enquiry</h2>
    <p class="mt-3 max-w-readable text-ink-muted">
      Use this to share what you are looking for and the best way to respond.
    </p>
    <p class="mt-4 rounded-2xl border border-line bg-paper px-4 py-3 text-sm leading-6 text-ink-muted">
      Please do not include detailed medical information here. If coaching is appropriate, any relevant screening
      information will be collected separately.
    </p>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <div>
      <label class="text-sm font-semibold" for={`${id}-firstName`}>First name</label>
      <input class={inputClass} id={`${id}-firstName`} name="firstName" type="text" autocomplete="given-name" maxlength="80" required />
      <p class={errorClass} data-error-for="firstName"></p>
    </div>

    <div>
      <label class="text-sm font-semibold" for={`${id}-lastName`}>Last name <span class="font-normal text-ink-muted">(optional)</span></label>
      <input class={inputClass} id={`${id}-lastName`} name="lastName" type="text" autocomplete="family-name" maxlength="80" />
      <p class={errorClass} data-error-for="lastName"></p>
    </div>

    <div>
      <label class="text-sm font-semibold" for={`${id}-email`}>Email address</label>
      <input class={inputClass} id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="254" required />
      <p class={errorClass} data-error-for="email"></p>
    </div>

    <div>
      <label class="text-sm font-semibold" for={`${id}-phone`}>Phone <span class="font-normal text-ink-muted">(optional)</span></label>
      <input class={inputClass} id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="40" />
      <p class={errorClass} data-error-for="phone"></p>
    </div>

    <div>
      <label class="text-sm font-semibold" for={`${id}-location`}>Location <span class="font-normal text-ink-muted">(optional)</span></label>
      <input class={inputClass} id={`${id}-location`} name="location" type="text" autocomplete="address-level2" maxlength="120" />
      <p class={errorClass} data-error-for="location"></p>
    </div>

    <div>
      <label class="text-sm font-semibold" for={`${id}-mainInterest`}>Main interest</label>
      <select class={inputClass} id={`${id}-mainInterest`} name="mainInterest" required>
        <option value="">Choose the closest option</option>
        {mainInterestOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
      <p class={errorClass} data-error-for="mainInterest"></p>
    </div>

    <div>
      <label class="text-sm font-semibold" for={`${id}-preferredContactMethod`}>
        Preferred contact method <span class="font-normal text-ink-muted">(optional)</span>
      </label>
      <select class={inputClass} id={`${id}-preferredContactMethod`} name="preferredContactMethod">
        <option value="">No preference selected</option>
        {preferredContactMethodOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
      <p class={errorClass} data-error-for="preferredContactMethod"></p>
    </div>

    <div>
      <label class="text-sm font-semibold" for={`${id}-referralSource`}>
        Referral source <span class="font-normal text-ink-muted">(optional)</span>
      </label>
      <input class={inputClass} id={`${id}-referralSource`} name="referralSource" type="text" maxlength="200" />
      <p class={errorClass} data-error-for="referralSource"></p>
    </div>

    <div class="sm:col-span-2">
      <label class="text-sm font-semibold" for={`${id}-socialHandle`}>
        Social handle <span class="font-normal text-ink-muted">(optional)</span>
      </label>
      <input class={inputClass} id={`${id}-socialHandle`} name="socialHandle" type="text" maxlength="120" placeholder="@username" />
      <p class={errorClass} data-error-for="socialHandle"></p>
    </div>

    <div class="sm:col-span-2">
      <label class="text-sm font-semibold" for={`${id}-message`}>Message</label>
      <textarea class={inputClass} id={`${id}-message`} name="message" rows="7" maxlength="3000" required></textarea>
      <p class={errorClass} data-error-for="message"></p>
    </div>
  </div>

  <div class="mt-2 grid gap-4">
    <label class="flex gap-3 text-sm leading-6 text-ink-muted">
      <input class="mt-1 h-4 w-4 rounded border-line text-accent focus:ring-accent" name="newsletterOptIn" type="checkbox" value="true" />
      <span>I would also like occasional writing/newsletter updates.</span>
    </label>

    <div>
      <label class="flex gap-3 text-sm leading-6 text-ink-muted">
        <input class="mt-1 h-4 w-4 rounded border-line text-accent focus:ring-accent" name="consentToContact" type="checkbox" value="true" required />
        <span>I consent to being contacted about this enquiry.</span>
      </label>
      <p class={errorClass} data-error-for="consentToContact"></p>
    </div>
  </div>

  <input type="hidden" name="sourcePage" />
  <input type="hidden" name="utmSource" />
  <input type="hidden" name="utmMedium" />
  <input type="hidden" name="utmCampaign" />
  <input type="hidden" name="utmTerm" />
  <input type="hidden" name="utmContent" />

  <div class="hidden" aria-hidden="true">
    <label for={`${id}-website`}>Website</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center">
    <button
      class="inline-flex items-center justify-center rounded-full bg-ink px-5 py-3 text-sm font-semibold text-paper-soft transition hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60"
      type="submit"
      data-idle-label="Send enquiry"
      data-loading-label="Sending…"
    >
      Send enquiry
    </button>
    <p class="text-sm text-ink-muted" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<script>
  import { enhanceForms } from "../../lib/form-client";

  enhanceForms();
  document.addEventListener("astro:page-load", enhanceForms);
</script>
