---
import TagPill from "../components/cards/TagPill.astro";
import NewsletterInline from "../components/sections/NewsletterInline.astro";
import { formatPostDate } from "../lib/writing";
import BaseLayout from "./BaseLayout.astro";
import type { WritingPost } from "../lib/writing";

interface Props {
  post: WritingPost;
}

const { post } = Astro.props;
const description = post.data.seoDescription ?? post.data.excerpt ?? post.data.description;
const title = post.data.seoTitle ?? post.data.title;
---

<BaseLayout
  title={title}
  description={description}
  canonical={post.data.canonicalUrl}
  ogImage={post.data.coverImage}
  ogType="article"
  publishedTime={post.data.publishedDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  tags={post.data.tags}
>
  <article class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-6 sm:py-16 lg:px-8">
    <a class="text-sm font-semibold text-ink-muted no-underline hover:text-ink hover:underline" href="/writing">
      ← Back to writing
    </a>

    <header class="mt-10 max-w-readable">
      <p class="eyebrow">{post.data.category ?? "Writing"}</p>
      <h1 class="mt-5 text-4xl font-semibold tracking-[-0.04em] sm:text-6xl">{post.data.title}</h1>
      <p class="lede mt-6">{post.data.excerpt ?? post.data.description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-muted">
        <p>
          Published <time datetime={post.data.publishedDate.toISOString()}>{formatPostDate(post.data.publishedDate)}</time>
        </p>
        {
          post.data.updatedDate && (
            <p>
              Updated <time datetime={post.data.updatedDate.toISOString()}>{formatPostDate(post.data.updatedDate)}</time>
            </p>
          )
        }
      </div>

      {
        post.data.tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label={`Tags for ${post.data.title}`}>
            {post.data.tags.map((tag) => (
              <li>
                <TagPill tag={tag} />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose prose-lg mt-12">
      <slot />
    </div>

    <NewsletterInline />
  </article>
</BaseLayout>
