{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ab-personal-training-preview",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "ENQUIRIES",
      "database_name": "ab-pt-enquiries",
      "database_id": "720c34f0-0a11-4518-9695-142c2635c708",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "INDEXABLE": "false",
  },
  "ratelimits": [
    {
      "name": "ENQUIRY_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
}
