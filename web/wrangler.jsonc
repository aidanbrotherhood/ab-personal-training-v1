{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ab-personal-training-staging",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "workers_dev": true,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "vars": {
    "INDEXABLE": "false",
    "NOTIFICATIONS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "ENQUIRIES",
      "database_name": "ab-pt-enquiries-staging",
      "database_id": "7af4c995-22ad-4ecd-9359-eec163d27e45",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ENQUIRY_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "env": {
    "production": {
      "name": "ab-personal-training-preview",
      "workers_dev": true,
      "vars": {
        "INDEXABLE": "true",
        "NOTIFICATIONS_ENABLED": "true",
        "GA_MEASUREMENT_ID": "G-NY57FTV5MZ"
      },
      "routes": [
        {
          "pattern": "aidanbrotherhood.com",
          "custom_domain": true
        },
        {
          "pattern": "www.aidanbrotherhood.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "ENQUIRIES",
          "database_name": "ab-pt-enquiries",
          "database_id": "720c34f0-0a11-4518-9695-142c2635c708",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "ENQUIRY_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ]
    }
  }
}
