# Local-only example for development on your machine.
# Copy to `.env.local` or `.env`; never commit real secrets.
# For the full Vercel/private deployment checklist, see `.env.example`
# and `docs/private-deployment.md`.

# Local stub mode validates forms and logs sanitised payloads only.
# Do not use `FORM_STUB_MODE=true` for a public production deployment.
FORM_STUB_MODE=true

# Local URL used by Astro/RSS/sitemap while developing.
SITE_URL=http://localhost:4321

# Buttondown local real-key test.
# Leave blank in stub mode. Never prefix secrets with `PUBLIC_`.
BUTTONDOWN_API_KEY=
BUTTONDOWN_API_BASE_URL=
BUTTONDOWN_API_VERSION=

# Attio local real-key test.
# Leave blank in stub mode. Never prefix secrets with `PUBLIC_`.
ATTIO_API_KEY=
ATTIO_API_BASE_URL=
ATTIO_COACHING_ENQUIRIES_LIST=

# Attio list field mappings for local real-key testing.
ATTIO_FIELD_STAGE=
ATTIO_FIELD_SUBMITTED_AT=
ATTIO_FIELD_MAIN_INTEREST=
ATTIO_FIELD_MESSAGE=
ATTIO_FIELD_LOCATION=
ATTIO_FIELD_PREFERRED_CONTACT_METHOD=
ATTIO_FIELD_REFERRAL_SOURCE=
ATTIO_FIELD_SOCIAL_HANDLE=
ATTIO_FIELD_NEWSLETTER_OPT_IN=
ATTIO_FIELD_SOURCE_PAGE=
ATTIO_FIELD_UTM_SOURCE=
ATTIO_FIELD_UTM_MEDIUM=
ATTIO_FIELD_UTM_CAMPAIGN=
ATTIO_FIELD_UTM_TERM=
ATTIO_FIELD_UTM_CONTENT=
ATTIO_FIELD_CONSENT_TO_CONTACT=
ATTIO_FIELD_STATUS_NOTES=
