# Deployment environment variable example.
# Use safe placeholders only. Never commit real secrets.
# None of these variables should be prefixed with PUBLIC_; they are read server-side.

# Required before private/live testing so canonical RSS and sitemap links are correct.
SITE_URL=https://example.com

# Required for private live integration tests. Use true only for local/dev stub testing.
FORM_STUB_MODE=false

# Required for private Buttondown newsletter tests.
BUTTONDOWN_API_KEY=

# Optional. Defaults to https://api.buttondown.com/v1 when empty.
BUTTONDOWN_API_BASE_URL=

# Optional. Omit to use the API key pinned/default Buttondown API version.
BUTTONDOWN_API_VERSION=

# Required for private Attio coaching enquiry tests.
ATTIO_API_KEY=

# Optional. Defaults to https://api.attio.com/v2 when empty.
ATTIO_API_BASE_URL=

# Required for private Attio coaching enquiry tests. Use the Attio list slug or ID.
ATTIO_COACHING_ENQUIRIES_LIST=

# Attio Coaching Enquiries list field mappings.
# The route can submit with only API key + list, but map the recommended
# fields below before testing real field capture:
# ATTIO_FIELD_STAGE, ATTIO_FIELD_SUBMITTED_AT, ATTIO_FIELD_MAIN_INTEREST,
# ATTIO_FIELD_MESSAGE, and ATTIO_FIELD_CONSENT_TO_CONTACT.
ATTIO_FIELD_STAGE=
ATTIO_FIELD_SUBMITTED_AT=
ATTIO_FIELD_MAIN_INTEREST=
ATTIO_FIELD_MESSAGE=
ATTIO_FIELD_PRIMARY_GOAL=
ATTIO_FIELD_SERVICE_PREFERENCE=
ATTIO_FIELD_CURRENT_TRAINING_LEVEL=
ATTIO_FIELD_GYM_CONFIDENCE=
ATTIO_FIELD_CURRENT_ROUTINE=
ATTIO_FIELD_BIGGEST_BARRIER=
ATTIO_FIELD_PREFERRED_COACHING_FORMAT=
ATTIO_FIELD_AVAILABILITY=
ATTIO_FIELD_START_TIMELINE=
ATTIO_FIELD_LOCATION=
ATTIO_FIELD_PREFERRED_CONTACT_METHOD=
ATTIO_FIELD_REFERRAL_SOURCE=
ATTIO_FIELD_SOCIAL_HANDLE=
ATTIO_FIELD_NEWSLETTER_OPT_IN=
ATTIO_FIELD_SOURCE_PAGE=
ATTIO_FIELD_UTM_SOURCE=
ATTIO_FIELD_UTM_MEDIUM=
ATTIO_FIELD_UTM_CAMPAIGN=
ATTIO_FIELD_UTM_TERM=
ATTIO_FIELD_UTM_CONTENT=
ATTIO_FIELD_CONSENT_TO_CONTACT=
ATTIO_FIELD_STATUS_NOTES=
